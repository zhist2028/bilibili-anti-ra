{
  "manifest_version": 3,
  "name": "B站推荐屏蔽 (Bilibili Anti-Feed)",
  "version": "1.3.0",
  "description": "登录后仅向白名单接口发送 Cookie，其余接口一律匿名。三种模式：屏蔽推荐（不展示）/ 匿名推荐（展示但算法拿不到你的画像）/ 关闭。",
  "permissions": ["declarativeNetRequest", "scripting", "storage"],
  "host_permissions": ["*://*.bilibili.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "B站推荐屏蔽：点击切换模式",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
